# Lion Satellite Studio settings. Copy to satellite.env (next to server.py) and edit.
# server.py reads this file at start; real environment variables win over it. Only LSS_* keys are read.
# Never put API keys here: they go in the keys file (LSS_KEYS_FILE), see README > Configuration.

# Where the web server listens. 127.0.0.1 = this machine only (default, recommended).
# To use it from a phone or another computer on a network you trust, set LSS_HOST=0.0.0.0
# (there is no login: put it behind an authenticating reverse proxy or tunnel before exposing it further).
LSS_HOST=127.0.0.1
LSS_PORT=8640

# Disk cache for upstream data (CelesTrak, USGS, GIBS, ASF NISAR SQLite, Hydrocron, Sentinel-1 searches and results).
# Grows to a few tens of MB; the NISAR footprint database is the largest part. Default: ./cache
# LSS_CACHE_DIR=~/.cache/lion-satellite-studio

# Natural Earth land polygons used by the radar ship detector's land mask. Default: ./data
# LSS_DATA_DIR=./data

# Optional keys file (AISSTREAM_API_KEY=..., GFW_API_TOKEN=...). chmod 600, never commit it. Default: ./keys.env
# LSS_KEYS_FILE=~/.config/lion-satellite-studio/keys.env

# Python interpreter that has the optional radar extras (requirements-radar.txt). Default: ./venv/bin/python
# Without it the app works; only the Sentinel-1 "Analyse" buttons say the extras are not installed.
# LSS_VENV_PYTHON=./venv/bin/python

# Optional contact appended to the User-Agent sent to data providers, so they can reach you about your traffic
# (for example a URL or an address you use for this). Leave empty to send only the generic
# "LionSatelliteStudio/1.0 (+https://github.com/sunnychase/lion-satellite-studio)".
# LSS_CONTACT=

# 1 = do not open the aisstream.io connection this run, even if a key is present.
# LSS_DISABLE_AIS=0
